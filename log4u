#!/bin/sh

gLevDebug=4
gLevInfo=3
gLevWarn=2
gLevErr=1
gLevFail=0

gLogInit=0
gLogDebug=

gLogColorRed=31
gLogColorGreen=32
gLogColorYellow=33
gLogColorPurple=35
gLogColorWhite=37

logLevelName() {
	case $1 in
		"$gLevDebug") printf '%s\n' DEBUG ;;
		"$gLevInfo")  printf '%s\n' INFO ;;
		"$gLevWarn")  printf '%s\n' WARN ;;
		"$gLevErr")   printf '%s\n' ERROR ;;
		"$gLevFail")  printf '%s\n' FAIL ;;
		*)            return 1 ;;
	esac
}

logReset() {
	gLogInit=0
	gLevLogConsole=$gLevInfo
	gLogConsole=1
	unset gLogColors
	unset gLogFile
	unset gLogAppend
	unset gLevLogFile
}

logStatus() {
	printf '%s\n' "gLogInit=$gLogInit, gLogColors=$gLogColors, gLevLogConsole=$(logLevelName "$gLevLogConsole"), gLogConsole=$gLogConsole, gLogFile=$gLogFile, gLogAppend=$gLogAppend, gLevLogFile=$(logLevelName "$gLevLogFile")"
}

logSetLevel() {
	if [ $gLogDebug ]; then set -vx; fi
	case $1 in
		DEBUG) gLevLogConsole=$gLevDebug ;;
		INFO)  gLevLogConsole=$gLevInfo ;;
		WARN)  gLevLogConsole=$gLevWarn ;;
		ERROR) gLevLogConsole=$gLevErr ;;
		FAIL)  gLevLogConsole=$gLevFail ;;
	esac
	if [ $gLogDebug ]; then set +vx; fi
}

logGetLevel() {
	logLevelName "$gLevLogConsole"
}

logInit() {
	if [ $gLogDebug ]; then set -vx; fi
	if [ -f "$1" ]; then
		# Color property for log
		grep -i '^LOG4U\.LOGCOLORS' $1 >/dev/null 2>&1
		[ $? -eq 0 ] && gLogColors=1 || gLogColors=0

		# Logging to console?
		grep -i '^LOG4U\.CONSOLE$' $1 >/dev/null 2>&1
		if [ $? -eq 0 ]; then 
			gLogConsole=1
			lLevLogName=$(grep -i '^LOG4U\.CONSOLE\.LEVEL' $1 | cut -d '=' -f2)
			case $lLevLogName in
			DEBUG)
				gLevLogConsole=$gLevDebug
				;;
			INFO)
				gLevLogConsole=$gLevInfo
				;;
			WARN)
				gLevLogConsole=$gLevWarn
				;;
			ERROR)
				gLevLogConsole=$gLevErr
				;;
			FAIL)
				gLevLogConsole=$gLevFail
				;;
			*)
				gLevLogConsole=$gLevInfo
				logErr "Invalid property value for property LOG4U.LOGLEVEL. Defaulting to INFO level"
				;;
			esac
		else
			gLogConsole=0
		fi
	
		# File logging property
		grep -i '^LOG4U\.LOGFILE=' $1 >/dev/null 2>&1
		if [ $? -eq 0 ]; then
			# Property is defined
			lLogFile=$(grep -i '^LOG4U\.LOGFILE=' $1 | cut -d '=' -f2 | cut -d ',' -f1)
			lLogAppend=$(grep -i '^LOG4U\.LOGFILE=.*,.*$' $1 | cut -d '=' -f2 | cut -d ',' -f2)
			if [ ! -z "$lLogFile" ]; then
				gLogFile=$lLogFile
				case $lLogAppend in
					[ad])
						gLogAppend=$lLogAppend
						;;
					*)
						gLogAppend=a
						;;
				esac

				# If a log file is defined, load its properties
				lLevLogName=$(grep -i '^LOG4U\.LOGFILE\.LEVEL=' $1 | cut -d '=' -f2)
				case $lLevLogName in
					DEBUG)
						gLevLogFile=$gLevDebug
						;;
					INFO)
						gLevLogFile=$gLevInfo
						;;
					WARN)
						gLevLogFile=$gLevWarn
						;;
					ERROR)
						gLevLogFile=$gLevErr
						;;
					FAIL)
						gLevLogFile=$gLevFail
						;;
					*)
						gLevLogFile=$gLevInfo
						logErr "Invalid property value for property LOG4U.LOGLEVEL. Defaulting to INFO level"
						;;
		    esac
			else
				gLogFile=""
				gLogAppend=""
				gLevLogFile=""
			fi
		else
			gLogFile=""
			gLogAppend=""
			gLevLogFile=""

		fi
		if [ -f "$gLogFile" ] && [ "$gLogAppend" = "d" ]; then
			rm -f "$gLogFile"
		fi
	
		gLogInit=1
	else
		logFail "Failure initializing log4u. Config file $1 not found. Using default values for properties"
		logReset
	fi
	if [ $gLogDebug ]; then set +vx; fi
}

log() {
	if [ $gLogDebug ]; then set -vx; fi
	lBuf="$1"
	lLevCurr=$2
	lColor=$3
	lTm=$(date +"%d/%m/%Y %H:%M:%S")
	# Formatter code here
	lMsg="${lTm} - $(logLevelName "$lLevCurr") - $0: $lBuf"
		
	if [ "${gLogConsole:-1}" -eq 1 ] && [ "${gLevLogConsole:-$gLevInfo}" -ge "$lLevCurr" ]; then
		if [ "${gLogColors:-0}" -eq 1 ]; then
			printf '\033[%sm%s\033[37m\n' "$lColor" "$lMsg"
		else
			printf '%s\n' "$lMsg"
		fi
	fi

	if [ -n "$gLogFile" ] && [ "${gLevLogFile:-$gLevInfo}" -ge "$lLevCurr" ]; then
		printf '%s\n' "$lMsg" >> "$gLogFile"
	fi

	if [ $gLogDebug ]; then set +vx; fi
}

logDebug() {
	log "$1" $gLevDebug $gLogColorWhite
}

logInfo() {
	log "$1" $gLevInfo $gLogColorWhite
}

logWarn() {
	log "$1" $gLevWarn $gLogColorYellow 1>&2
}

logErr() {
	log "$1" $gLevErr $gLogColorRed 1>&2
}

logFail() {
	log "$1" $gLevFail $gLogColorPurple 1>&2
}
