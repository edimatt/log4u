#!/bin/sh

gLevDebug=4
gLevInfo=3
gLevWarn=2
gLevErr=1
gLevFail=0

gLogDebug=

gLogColorRed=31
gLogColorGreen=32
gLogColorYellow=33
gLogColorPurple=35
gLogColorWhite=37

logLevelName() {
	case "$1" in
		"$gLevDebug") printf '%s\n' DEBUG ;;
		"$gLevInfo")  printf '%s\n' INFO ;;
		"$gLevWarn")  printf '%s\n' WARN ;;
		"$gLevErr")   printf '%s\n' ERROR ;;
		"$gLevFail")  printf '%s\n' FAIL ;;
		*)            return 1 ;;
	esac
}

logReset() {
	gLevLogConsole=$gLevInfo
	gLogConsole=1
	gLogColors=0
	gLogFile=
	gLogAppend=a
	gLevLogFile=$gLevInfo
}

logReset

logStatus() {
	printf '%s\n' "gLogColors=$gLogColors, gLevLogConsole=$(logLevelName "$gLevLogConsole"), gLogConsole=$gLogConsole, gLogFile=$gLogFile, gLogAppend=$gLogAppend, gLevLogFile=$(logLevelName "$gLevLogFile")"
}

logSetLevel() {
	if [ "$gLogDebug" ]; then set -vx; fi
	case "$1" in
		DEBUG) gLevLogConsole=$gLevDebug ;;
		INFO)  gLevLogConsole=$gLevInfo ;;
		WARN)  gLevLogConsole=$gLevWarn ;;
		ERROR) gLevLogConsole=$gLevErr ;;
		FAIL)  gLevLogConsole=$gLevFail ;;
	esac
	if [ "$gLogDebug" ]; then set +vx; fi
}

logGetLevel() {
	logLevelName "$gLevLogConsole"
}

logTrim() {
	lTrimValue=$1
	lTrimValue=${lTrimValue#"${lTrimValue%%[![:space:]]*}"}
	lTrimValue=${lTrimValue%"${lTrimValue##*[![:space:]]}"}
	printf '%s\n' "$lTrimValue"
}

logLevelValue() {
	case "$1" in
		DEBUG) printf '%s\n' "$gLevDebug" ;;
		INFO)  printf '%s\n' "$gLevInfo" ;;
		WARN)  printf '%s\n' "$gLevWarn" ;;
		ERROR) printf '%s\n' "$gLevErr" ;;
		FAIL)  printf '%s\n' "$gLevFail" ;;
		*)     return 1 ;;
	esac
}

logConfigError() {
	printf 'log4u: %s\n' "$1" >&2
}

logInitError() {
	logConfigError "$1"
	if [ "$gLogDebug" ]; then set +vx; fi
	return 1
}

logInit() {
	if [ "$gLogDebug" ]; then set -vx; fi
	if [ ! -f "$1" ]; then
		logInitError "configuration file not found: $1"
		return 1
	fi

	lConfigColors=0
	lConfigConsole=0
	lConfigConsoleLevel=$gLevInfo
	lConfigFile=
	lConfigFileMode=a
	lConfigFileLevel=$gLevInfo
	lConfigLineNumber=0

	while IFS= read -r lConfigLine || [ -n "$lConfigLine" ]; do
		lConfigLineNumber=$((lConfigLineNumber + 1))
		lConfigLine=$(logTrim "$lConfigLine")

		case "$lConfigLine" in
			''|\#*) continue ;;
		esac

		case "$lConfigLine" in
			*=*)
				lConfigKey=$(logTrim "${lConfigLine%%=*}")
				lConfigValue=$(logTrim "${lConfigLine#*=}")
				;;
			*)
				lConfigKey=$lConfigLine
				lConfigValue=
				;;
		esac

		case "$lConfigKey" in
			LOG4U.LOGCOLORS)
				if [ -n "$lConfigValue" ]; then
					logInitError "line $lConfigLineNumber: LOG4U.LOGCOLORS does not accept a value"
					return 1
				fi
				lConfigColors=1
				;;
			LOG4U.CONSOLE)
				if [ -n "$lConfigValue" ]; then
					logInitError "line $lConfigLineNumber: LOG4U.CONSOLE does not accept a value"
					return 1
				fi
				lConfigConsole=1
				;;
			LOG4U.CONSOLE.LEVEL)
				if ! lConfigLevel=$(logLevelValue "$lConfigValue"); then
					logInitError "line $lConfigLineNumber: invalid console level '$lConfigValue'"
					return 1
				fi
				lConfigConsoleLevel=$lConfigLevel
				;;
			LOG4U.LOGFILE)
				lConfigFile=$(logTrim "${lConfigValue%%,*}")
				if [ -z "$lConfigFile" ]; then
					logInitError "line $lConfigLineNumber: LOG4U.LOGFILE requires a filename"
					return 1
				fi
				if [ "$lConfigValue" = "$lConfigFile" ]; then
					lConfigFileMode=a
				else
					lConfigFileMode=$(logTrim "${lConfigValue#*,}")
					case "$lConfigFileMode" in
						a|d) ;;
						*)
							logInitError "line $lConfigLineNumber: invalid logfile mode '$lConfigFileMode'"
							return 1
							;;
					esac
				fi
				;;
			LOG4U.LOGFILE.LEVEL)
				if ! lConfigLevel=$(logLevelValue "$lConfigValue"); then
					logInitError "line $lConfigLineNumber: invalid logfile level '$lConfigValue'"
					return 1
				fi
				lConfigFileLevel=$lConfigLevel
				;;
			*)
				logInitError "line $lConfigLineNumber: unknown property '$lConfigKey'"
				return 1
				;;
		esac
	done < "$1"

	if [ -f "$lConfigFile" ] && [ "$lConfigFileMode" = "d" ]; then
		if ! rm -f "$lConfigFile"; then
			logInitError "could not remove logfile: $lConfigFile"
			return 1
		fi
	fi

	gLogColors=$lConfigColors
	gLogConsole=$lConfigConsole
	gLevLogConsole=$lConfigConsoleLevel
	gLogFile=$lConfigFile
	gLogAppend=$lConfigFileMode
	gLevLogFile=$lConfigFileLevel

	if [ "$gLogDebug" ]; then set +vx; fi
	return 0
}

log() {
	if [ "$gLogDebug" ]; then set -vx; fi
	lBuf="$1"
	lLevCurr=$2
	lColor=$3
	lLogStatus=0
	lTm=$(date +"%d/%m/%Y %H:%M:%S")
	# Formatter code here
	lMsg="${lTm} - $(logLevelName "$lLevCurr") - $0: $lBuf"
		
	if [ "${gLogConsole:-1}" -eq 1 ] && [ "${gLevLogConsole:-$gLevInfo}" -ge "$lLevCurr" ]; then
		if [ "${gLogColors:-0}" -eq 1 ]; then
			printf '\033[%sm%s\033[0m\n' "$lColor" "$lMsg" || lLogStatus=1
		else
			printf '%s\n' "$lMsg" || lLogStatus=1
		fi
	fi

	if [ -n "$gLogFile" ] && [ "${gLevLogFile:-$gLevInfo}" -ge "$lLevCurr" ]; then
		printf '%s\n' "$lMsg" >> "$gLogFile" || lLogStatus=1
	fi

	if [ "$gLogDebug" ]; then set +vx; fi
	return "$lLogStatus"
}

logDebug() {
	log "$1" "$gLevDebug" "$gLogColorWhite"
}

logInfo() {
	log "$1" "$gLevInfo" "$gLogColorWhite"
}

logWarn() {
	log "$1" "$gLevWarn" "$gLogColorYellow" 1>&2
}

logErr() {
	log "$1" "$gLevErr" "$gLogColorRed" 1>&2
}

logFail() {
	log "$1" "$gLevFail" "$gLogColorPurple" 1>&2
}
